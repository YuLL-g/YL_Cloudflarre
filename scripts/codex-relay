#!/bin/sh
# Linux launcher: apply relay settings only to Codex and its child processes.
export HTTP_PROXY=http://127.0.0.1:7890
export HTTPS_PROXY=http://127.0.0.1:7890
export http_proxy="$HTTP_PROXY"
export https_proxy="$HTTPS_PROXY"
export NO_PROXY="localhost,127.0.0.1,::1${CODEX_RELAY_NO_PROXY:+,$CODEX_RELAY_NO_PROXY}"
export no_proxy="$NO_PROXY"
unset ALL_PROXY all_proxy
exec "${CODEX_RELAY_BIN:-codex}" "$@"
