[Unit]
Description=TransCodex loopback HTTP CONNECT bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=12

[Service]
Type=simple
# Replace all /home/YOUR_USER occurrences and YOUR_USER. Do not leave placeholders.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER
ExecStart=/usr/bin/python3 /home/YOUR_USER/.local/bin/cfws_bridge.py --config /home/YOUR_USER/.config/transcodex/bridge.json
Restart=always
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
